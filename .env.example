# Supabase project (client-side config — the anon key is publishable by design;
# data access is enforced by Row Level Security, not key secrecy)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<legacy anon JWT from Supabase dashboard → Settings → API>

# Dev-only: skip real auth in the browser (fake local user, no remote sync)
# VITE_MOCK_AUTH=1
